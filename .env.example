# Токен бота от @BotFather
BOT_TOKEN=
# Ключ Gemini API из https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модели Gemini через запятую: основная, затем резервные (если основная упрётся в лимит)
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Сколько фото один пользователь может отправить в день (защита бесплатного лимита API)
DAILY_LIMIT=10
# Папка для базы данных и фото
DATA_DIR=data

# --- Mini App (Taza Map) ---
# Локальный порт веб-сервера (на хостинге берётся из переменной PORT)
WEB_PORT=8080
# Публичный HTTPS-адрес этого сервера. На Railway/Render можно не задавать — адрес подставится сам.
# Локально без адреса кнопки карты в боте скрыты
WEBAPP_URL=
# Telegram ID инспекторов через запятую — им доступна вкладка «Модерация»
ADMIN_IDS=
# true — модерация открыта всем (чтобы жюри могло пройти весь сценарий). В продакшне — false
DEMO_MODE=true
# Сколько баллов житель получает за подтверждённое нарушение
REWARD_POINTS=100
# auto — webhook на Render, polling локально. Можно принудительно: polling или webhook
BOT_MODE=auto
